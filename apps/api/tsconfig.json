{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@tenantbot/core": ["../../packages/core/src/index.ts"],
      "@tenantbot/core/*": ["../../packages/core/src/*"],
      "@tenantbot/db": ["../../packages/db/src/index.ts"],
      "@tenantbot/db/*": ["../../packages/db/src/*"]
    }
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
